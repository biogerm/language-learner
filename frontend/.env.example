# Copy this file to .env.local and fill in your keys.
# DO NOT commit .env.local to version control.

# ------------------------------------------
# 1. Supabase Configuration (Database, Auth)
# ------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_DB_PWD=
SUPABASE_SERVICE_API_KEY=

# ------------------------------------------
# 2. Cloudflare R2 Configuration (Storage)
# ------------------------------------------
VITE_R2_PUBLIC_URL=
R2_AccessKeyID=
R2_SecretAccessKey=
R2_TokenValue=
R2_Endpoint_S3=

# ------------------------------------------
# 3. Test Account Credentials
# ------------------------------------------
TEST_USER_EMAIL=
TEST_USER_PASSWORD=
VITE_TEST_USER_EMAIL=
