{
    "article_id": "article_57",
    "topic": "Supplementary Sentences",
    "theme": "Everyday Expressions and Dialogues",
    "level": "B1",
    "sentences": [
        {
            "sentence_id": "art_57_s001",
            "sv": "– Ha en bra dag!\n– Du med.",
            "en": "",
            "target_words": []
        },
        {
            "sentence_id": "art_57_s002",
            "sv": "– Trevlig helg!\n– Tack, du också.",
            "en": "",
            "target_words": []
        },
        {
            "sentence_id": "art_57_s003",
            "sv": "– Jag vet inte hur jag ska lösa det här.\n– Du skulle kunna försöka prata med chefen.",
            "en": "",
            "target_words": []
        },
        {
            "sentence_id": "art_57_s004",
            "sv": "– Min dator är så långsam.\n– Du skulle kunna prova att starta om den.",
            "en": "",
            "target_words": []
        },
        {
            "sentence_id": "art_57_s005",
            "sv": "– Jag kan inte öppna burken.\n– Har du försökt att värma locket?",
            "en": "",
            "target_words": []
        },
        {
            "sentence_id": "art_57_s006",
            "sv": "– Har du hört att Maria ska flytta?\n– Nej, vart då?",
            "en": "",
            "target_words": []
        },
        {
            "sentence_id": "art_57_s007",
            "sv": "– Jag har ont i ryggen.\n– Har du provat att stretcha?",
            "en": "",
            "target_words": []
        },
        {
            "sentence_id": "art_57_s008",
            "sv": "– Har ni hört att företaget ska säljas?\n– Ja, det stod i tidningen.",
            "en": "",
            "target_words": []
        },
        {
            "sentence_id": "art_57_s009",
            "sv": "– Länge sen vi sågs! Hoppas du mår bra!\n– Tack, allt är bra med mig.",
            "en": "",
            "target_words": []
        },
        {
            "sentence_id": "art_57_s010",
            "sv": "– Välkomna till mötet. Hoppas ni alla mår bra!\n– Tack, vi mår toppen.",
            "en": "",
            "target_words": []
        },
        {
            "sentence_id": "art_57_s011",
            "sv": "– Hur många år har du jobbat här?\n– Snart fem år faktiskt.",
            "en": "",
            "target_words": []
        },
        {
            "sentence_id": "art_57_s012",
            "sv": "– Vet du vem Anders är? Hur många år har han jobbat här?\n– Han började förra året.",
            "en": "",
            "target_words": []
        },
        {
            "sentence_id": "art_57_s013",
            "sv": "– Anna kan verkligen allt. Hur många år har hon jobbat här?\n– Sedan företaget startade.",
            "en": "",
            "target_words": []
        },
        {
            "sentence_id": "art_57_s014",
            "sv": "– Vi behöver köpa stolar.\n– Hur många?",
            "en": "",
            "target_words": []
        },
        {
            "sentence_id": "art_57_s015",
            "sv": "– Jag köpte äpplen idag.\n– Hur många äpplen köpte du?",
            "en": "",
            "target_words": []
        },
        {
            "sentence_id": "art_57_s016",
            "sv": "– Hur har ni det på semestern?\n– Här är allting härligt.",
            "en": "",
            "target_words": []
        },
        {
            "sentence_id": "art_57_s017",
            "sv": "– Är ni nöjda med nya lägenheten?\n– Ja, här är allting toppen.",
            "en": "",
            "target_words": []
        },
        {
            "sentence_id": "art_57_s018",
            "sv": "– Hur trivs ni i Spanien?\n– Här är allting underbart.",
            "en": "",
            "target_words": []
        },
        {
            "sentence_id": "art_57_s019",
            "sv": "– Jag måste berätta en grej… Jag har fått ett nytt jobb!\n– Grattis! Vad roligt!",
            "en": "",
            "target_words": []
        },
        {
            "sentence_id": "art_57_s020",
            "sv": "– Jag måste berätta en sak… Vi ska ha barn!\n– Men åh, grattis!",
            "en": "",
            "target_words": []
        },
        {
            "sentence_id": "art_57_s021",
            "sv": "– Jag tänker cykla i snöstormen.\n– Skulle det inte vara bättre att ta bussen?",
            "en": "",
            "target_words": []
        },
        {
            "sentence_id": "art_57_s022",
            "sv": "– Glöm inte att betala hyran idag.\n– Vilken tur att du påminde mig.",
            "en": "",
            "target_words": []
        },
        {
            "sentence_id": "art_57_s023",
            "sv": "Den där mannen kallas tyvärr ofta för alkis på grund av sitt drickande.",
            "en": "",
            "target_words": []
        },
        {
            "sentence_id": "art_57_s024",
            "sv": "Att vara alkoholist är en allvarlig sjukdom som kräver behandling.",
            "en": "",
            "target_words": []
        },
        {
            "sentence_id": "art_57_s025",
            "sv": "Jag skulle vilja ha en annan färg på tröjan, kanske blå.",
            "en": "",
            "target_words": []
        },
        {
            "sentence_id": "art_57_s026",
            "sv": "Vi måste prata om ett annat problem innan vi går vidare.",
            "en": "",
            "target_words": [
                {
                    "word_in_sentence": "annat",
                    "base_form": "annat",
                    "position_start": 22,
                    "position_end": 27
                }
            ]
        },
        {
            "sentence_id": "art_57_s027",
            "sv": "Mötet är imorgon, det vill säga på onsdag.",
            "en": "",
            "target_words": []
        },
        {
            "sentence_id": "art_57_s028",
            "sv": "Vi brukar ha personalmöte ungefär en gång i månaden.",
            "en": "",
            "target_words": []
        },
        {
            "sentence_id": "art_57_s029",
            "sv": "Jag försöker träna på gymmet minst en gång i veckan.",
            "en": "",
            "target_words": []
        },
        {
            "sentence_id": "art_57_s030",
            "sv": "Resan tog en och en halv timme med tåg.",
            "en": "",
            "target_words": []
        },
        {
            "sentence_id": "art_57_s031",
            "sv": "Min pappa blev flintis redan när han var trettio.",
            "en": "",
            "target_words": []
        },
        {
            "sentence_id": "art_57_s032",
            "sv": "Många män väljer att raka av håret helt när de börjar bli flintskalliga.",
            "en": "",
            "target_words": []
        },
        {
            "sentence_id": "art_57_s033",
            "sv": "Yttrandefrihet är en viktig frihet i ett demokratiskt samhälle.",
            "en": "",
            "target_words": []
        },
        {
            "sentence_id": "art_57_s034",
            "sv": "Snart hoppas vi att allt kan gå tillbaka till det normala igen.",
            "en": "",
            "target_words": []
        },
        {
            "sentence_id": "art_57_s035",
            "sv": "Efter semestern var det svårt att gå tillbaka till det vanliga livet.",
            "en": "",
            "target_words": []
        },
        {
            "sentence_id": "art_57_s036",
            "sv": "Det är strängt förbjudet att handla med utrotningshotade djur.",
            "en": "",
            "target_words": []
        },
        {
            "sentence_id": "art_57_s037",
            "sv": "Hennes högsta dröm är att öppna ett eget kafé i stan.",
            "en": "",
            "target_words": []
        },
        {
            "sentence_id": "art_57_s038",
            "sv": "– Vi har tyvärr slut på kaffe.\n– Jaha, då får jag väl dricka te istället.",
            "en": "",
            "target_words": []
        },
        {
            "sentence_id": "art_57_s039",
            "sv": "Jag börjar känna mig ganska trött efter den långa promenaden.",
            "en": "",
            "target_words": []
        },
        {
            "sentence_id": "art_57_s040",
            "sv": "Han brukar ofta känna sig nervös inför stora presentationer.",
            "en": "",
            "target_words": []
        },
        {
            "sentence_id": "art_57_s041",
            "sv": "Det var exakt lika många kvinnor som män på festen.",
            "en": "",
            "target_words": []
        },
        {
            "sentence_id": "art_57_s042",
            "sv": "Tycker du att det här är en lämplig klädsel för en arbetsintervju?",
            "en": "",
            "target_words": []
        },
        {
            "sentence_id": "art_57_s043",
            "sv": "Vi säljer böcker, pennor, block med mera i vår lilla butik.",
            "en": "",
            "target_words": []
        },
        {
            "sentence_id": "art_57_s044",
            "sv": "Du måste städa rummet, diska, tvätta fönstren och så vidare.",
            "en": "",
            "target_words": []
        },
        {
            "sentence_id": "art_57_s045",
            "sv": "På hösten brukar vi gå ut i skogen för att plocka svamp.",
            "en": "",
            "target_words": []
        },
        {
            "sentence_id": "art_57_s046",
            "sv": "Personalen och deras respektive är inbjudna till julfesten.",
            "en": "",
            "target_words": []
        },
        {
            "sentence_id": "art_57_s047",
            "sv": "Människor har bott på den här platsen sedan urminnes tider.",
            "en": "",
            "target_words": []
        },
        {
            "sentence_id": "art_57_s048",
            "sv": "Jag föredrar att sitta längst fram i klassrummet.",
            "en": "",
            "target_words": []
        },
        {
            "sentence_id": "art_57_s049",
            "sv": "Vi ska resa till Italien nästa sommar om vi har råd.",
            "en": "",
            "target_words": []
        },
        {
            "sentence_id": "art_57_s050",
            "sv": "Reglerna anger att varje spelare skall bära hjälm under matchen.",
            "en": "",
            "target_words": []
        },
        {
            "sentence_id": "art_57_s051",
            "sv": "Kan du skriva ner ditt telefonnummer på den här lappen?",
            "en": "",
            "target_words": []
        },
        {
            "sentence_id": "art_57_s052",
            "sv": "Han lider av en så kallad kontorsnacke efter att ha suttit framför datorn hela dagarna.",
            "en": "",
            "target_words": []
        },
        {
            "sentence_id": "art_57_s053",
            "sv": "Det regnade så mycket att till och med gatorna översvämmades.",
            "en": "",
            "target_words": []
        },
        {
            "sentence_id": "art_57_s054",
            "sv": "Min dotter är i tioårsåldern och älskar att rida.",
            "en": "",
            "target_words": []
        },
        {
            "sentence_id": "art_57_s055",
            "sv": "Vi kan toppa pizzan med lite färsk basilika innan vi äter.",
            "en": "",
            "target_words": []
        },
        {
            "sentence_id": "art_57_s056",
            "sv": "Tänk dig att vinna på lotteri och aldrig behöva jobba mer!",
            "en": "",
            "target_words": []
        },
        {
            "sentence_id": "art_57_s057",
            "sv": "Tänk er en värld där alla har tillräckligt med mat.",
            "en": "",
            "target_words": []
        },
        {
            "sentence_id": "art_57_s058",
            "sv": "Det är bättre att fråga en gång för mycket än att göra fel.",
            "en": "",
            "target_words": []
        }
    ]
}